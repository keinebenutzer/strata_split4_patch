diff --git a/engine/src/split/src/arch_caps.hpp b/engine/src/split/src/arch_caps.hpp
new file mode 100644
index 000000000..cde7e072b
--- /dev/null
+++ b/engine/src/split/src/arch_caps.hpp
@@ -0,0 +1,94 @@
+#pragma once
+// What a CUDA compute capability brings, in one table instead of `#if FNX_ARCH >= 80` spread over the kernels: the
+// shared memory a block may opt into, whether the four-way int8 dot product exists, which f16 mma the tree uses, and
+// which architectures Strata has actually run this engine on. CPU-only, so tools/arch_caps_test.cpp can hold the
+// numbers without a card: a machine nobody has tried gets an answer in words before a three-minute model load ends
+// in a kernel error.
+//
+// The per-block dynamic shared memory is the limit that decides kernel layouts. Published values (CUDA Programming
+// Guide, "Memory Information" table and its footnote): 7.0 Volta 96 KiB, 7.5 Turing 64 KiB, 8.0 163 KiB, 8.6 and
+// 8.9 99 KiB, 8.7 163 KiB, 9.0 227 KiB, 10.0/10.3/11.0 227 KiB, 12.x 99 KiB. Anything unlisted takes the floor:
+// asking a card for more than it has fails the launch, and the smaller kernel layout is correct either way, only
+// slower (the HIP build has always used the 16-column layout against the CUDA build's 32 and its results are
+// bit-identical, hip/selftest_policy.hpp).
+#include <cstdlib>
+#include <functional>
+#include <string>
+#include <vector>
+
+namespace fnx {
+
+// what an unlisted capability is assumed to have, so a new card is never given a bigger kernel than it can run
+constexpr int SMEM_FLOOR_KIB = 64;
+
+constexpr int smem_per_block_kib(int cc) {
+    return cc == 70 ? 96                       // Volta
+         : cc == 75 ? 64                       // Turing (2080, 3090, T4)
+         : (cc == 80 || cc == 87) ? 163       // A100/A800 class
+         : (cc == 86 || cc == 89) ? 99        // GA10x (A4000, A5000, 3090) and Ada
+         : cc >= 90 && cc < 120 ? 227         // Hopper and data-center Blackwell
+         : cc >= 120 && cc < 130 ? 99        // consumer Blackwell (RTX 50xx, RTX PRO 6000)
+         : SMEM_FLOOR_KIB;
+}
+constexpr int smem_per_block(int cc) { return smem_per_block_kib(cc) * 1024; }
+
+// the four-way int8 dot product (ggml's decode readers, the IQ2/IQ4 types): sm_61 and newer
+constexpr bool has_dp4a(int cc) { return cc >= 61; }
+// the Ampere-style f16 mma (m16n8k16) that the tree's `FNX_ARCH >= 80` kernels are laid out for; below it the
+// m8n8k4 path runs (src/split/src/moe_mma.cuh, laid out for 64-row jobs)
+constexpr bool has_mma_16816(int cc) { return cc >= 80; }
+// the INT8 tensor-core attention tile and the tensor-core GDN prompt kernel (attn_prompt_i8.cuh, gdn_tc_prompt.cuh):
+// compiled for these cards only, below them the f16 kernels run
+constexpr bool has_i8_attention(int cc) { return cc >= 80; }
+
+// The architectures Strata has run the all-cards split on (strata_control/split_engine.py keeps the matching TESTED
+// table for the card counts): sm_86 (2x RTX A6000, the 61-task suite, pictures, hashes) and sm_120 (2x RTX PRO 6000).
+// Four cards on sm_86 was run and measured by this site on 2026-11-11; the engine still asks the self-test of a card
+// it has not run on, which is what makes a new architecture a question to measure instead of a guess.
+constexpr bool arch_run_by_strata(int cc) { return cc == 86 || cc == 120; }
+
+// one plain line about a card: what it can do, and what the engine therefore does with it
+inline std::string arch_note(int cc) {
+    std::string s = "sm_" + std::to_string(cc) + ": " + std::to_string(smem_per_block_kib(cc)) + " KiB shared memory a block";
+    s += has_dp4a(cc) ? ", dp4a yes" : ", dp4a NO (int8 experts would not run)";
+    s += has_mma_16816(cc) ? ", f16 mma 16816 yes" : ", f16 mma 16816 no (m8n8k4 path)";
+    s += has_i8_attention(cc) ? ", int8 attention path" : ", f16 attention path";
+    s += arch_run_by_strata(cc) ? ", run by Strata" : ", not run by Strata (the kernel self-test decides)";
+    return s;
+}
+
+// The NVIDIA-side mirror of hip/selftest_policy.hpp: on a card Strata has not run the split on, check the kernels
+// against a scalar reference before anything is loaded. FNX_SELFTEST=1 asks for it on a known card too (to see it
+// pass), FNX_SELFTEST=0 skips it (a tester who takes the risk), FNX_SELFTEST_FAIL=1 forces a failure (tests).
+struct NvSelftestDecision {
+    bool run = false;
+    bool ok = true;
+    std::vector<std::string> lines;
+};
+
+inline NvSelftestDecision nv_selftest_decide(int cc, const char* env_selftest, const char* env_fail,
+                                             const std::function<std::string(std::string&)>& run) {
+    NvSelftestDecision d;
+    const bool known = arch_run_by_strata(cc);
+    const bool forced = env_selftest && std::string(env_selftest) == "1";
+    if (known && !forced) return d;
+    if (env_selftest && std::string(env_selftest) == "0") return d;
+    const std::string arch = "sm_" + std::to_string(cc);
+    if (!known)
+        d.lines.push_back("The split engine is experimental on this card (" + arch + ", " + arch_note(cc) +
+                          "): Strata has not run it on this architecture. Please report whether it works.");
+    d.run = true;
+    std::string covered, bad;
+    if (env_fail && std::string(env_fail) == "1") bad = "forced failure (FNX_SELFTEST_FAIL=1)";
+    else bad = run(covered);
+    if (!bad.empty()) {
+        d.ok = false;
+        d.lines.push_back("The split engine's self-test failed on " + arch + " (" + bad +
+                          "), so it does not run on this card: the normal layer split starts instead.");
+        return d;
+    }
+    d.lines.push_back("The split engine's self-test passed on " + arch + " (" + covered + ").");
+    return d;
+}
+
+}  // namespace fnx
diff --git a/engine/src/split/src/gdn_prompt.cuh b/engine/src/split/src/gdn_prompt.cuh
index 745c7e87a..a24cb8bbc 100644
--- a/engine/src/split/src/gdn_prompt.cuh
+++ b/engine/src/split/src/gdn_prompt.cuh
@@ -163,13 +163,20 @@ __global__ void __launch_bounds__(GDN_PF_THREADS) k_gdn_pf_rec(const float* __re
 // k_gdn_ch_prep makes what does not depend on the state for every sub-chunk and head at once (T, P, G, the decays to the
 // end, b); k_gdn_ch_rec walks the sub-chunks in order per (value head, GCB columns), the state's columns in shared
 // memory. The sums come in another order than k_gdn_core's, row by row (fp32 either way).
+constexpr int GCH = 32, GCH_THREADS = 256;
+// The state columns one block carries: 32 where the card's shared memory holds the 72.6 KiB that layout needs, 16
+// where it does not (Turing's 64 KiB a block, gfx12's 64 KiB LDS: 56.6 KiB, in 128 threads and twice the blocks a
+// head). Every output's sum runs in the same order either way, so this is a size question, not a numerical one -- the
+// HIP build has always used 16 against the CUDA build's 32 and its results are bit-identical. The card's limit comes
+// from arch_caps.hpp, so four Turing or four Blackwell cards get the layout they can launch instead of a
+// cudaFuncSetAttribute error three minutes into the model load.
+constexpr int gch_rec_floats(int gcb) { return 2 * GCH * (HS + 1) + HS * gcb + 4 * GCH * gcb + (2 * GCH * GCH + 3 * GCH + 1); }
 #if FNX_HIP
-// gfx12 has 64 KB of LDS a block: k_gdn_ch_rec takes 16 state columns (58 KB) in 128 threads, twice the blocks a head; every output's sum
-// runs in the same order as with 32 columns, so the results are bit-identical to the CUDA build's layout
-constexpr int GCH = 32, GCB = 16, GCH_THREADS = 256, GCR_THREADS = 128, GCH_REC_BLOCKS_PER_HEAD = HS / GCB;
+constexpr bool GCH_WIDE = false;   // (FNX_ARCH is a gfx number here; the 64 KB LDS above is gfx12's own figure)
 #else
-constexpr int GCH = 32, GCB = 32, GCH_THREADS = 256, GCR_THREADS = 256, GCH_REC_BLOCKS_PER_HEAD = HS / GCB;
+constexpr bool GCH_WIDE = gch_rec_floats(32) * (int) sizeof(float) <= fnx::smem_per_block(FNX_ARCH);
 #endif
+constexpr int GCB = GCH_WIDE ? 32 : 16, GCR_THREADS = GCH_WIDE ? 256 : 128, GCH_REC_BLOCKS_PER_HEAD = HS / GCB;
 constexpr int GCR_CG = GCB / 4;   // column groups of 4 in a block's columns
 // the decays from sums of up to GCH logs: --use_fast_math makes expf __expf, whose error grows with the argument (2 +
 // 1.16 |x| ulp), so these go through double, which fast math leaves exact
@@ -252,6 +259,12 @@ __global__ void __launch_bounds__(GCH_THREADS) k_gdn_ch_prep(const float* __rest
 }
 
 constexpr size_t GCH_REC_SMEM = sizeof(float) * (2 * GCH * (HS + 1) + HS * GCB + 4 * GCH * GCB + GCH_PREP_FLOATS);
+#if !FNX_HIP
+// the choice above is checked here, so a card that cannot launch this kernel says so at compile time instead of in
+// cudaFuncSetAttribute after the model has been read (kernels.cu, ck_launch)
+static_assert(GCH_REC_SMEM <= (size_t) fnx::smem_per_block(FNX_ARCH),
+              "k_gdn_ch_rec asks a card for more shared memory than a block can opt into (src/arch_caps.hpp)");
+#endif
 // a thread's share of a sub-chunk's inputs, fetched into registers while the sub-chunk before computes
 constexpr int GCH_KQ_PER = GCH * HS / GCR_THREADS, GCH_V_PER = GCH * GCB / GCR_THREADS,
               GCH_PRE_PER = (GCH_PREP_FLOATS + GCR_THREADS - 1) / GCR_THREADS;
