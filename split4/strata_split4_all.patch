diff --git a/terminal/tests/split/test_arch_caps_parity.py b/terminal/tests/split/test_arch_caps_parity.py
new file mode 100644
index 000000000..659d3665f
--- /dev/null
+++ b/terminal/tests/split/test_arch_caps_parity.py
@@ -0,0 +1,70 @@
+#!/usr/bin/env python3
+# /// script
+# requires-python = ">=3.12"
+# ///
+"""Hält die zwei Shared-Memory-Tabellen zusammen: die des Engine-Codes (src/split/src/arch_caps.hpp) und die der
+Kartenregel (strata_control/split_engine.py). Bewiesen wird über den Compiler, nicht über eingelesenen Text --
+ein kleines C++-Programm gegen den Header ausgedruckt und Zahl für Zahl gegen shared_mem_kib() gehalten.
+
+    python3 tests/split/test_arch_caps_parity.py
+"""
+import pathlib
+import subprocess
+import sys
+import tempfile
+
+ROOT = pathlib.Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT))
+from strata_control import split_engine as SE                     # noqa: E402
+
+CCS = [61, 70, 75, 80, 86, 87, 89, 90, 100, 103, 110, 120, 121, 130, 135]
+
+CPP = """
+#include "arch_caps.hpp"
+#include <cstdio>
+int main() {
+    const int ccs[] = {%s};
+    for (int cc : ccs) printf("%%d:%%d\\n", cc, fnx::smem_per_block_kib(cc));
+    return 0;
+}
+""" % ", ".join(str(c) for c in CCS)
+
+
+def main() -> int:
+    with tempfile.TemporaryDirectory() as td:
+        src = pathlib.Path(td) / "probe.cpp"
+        exe = pathlib.Path(td) / "probe"
+        src.write_text(CPP, encoding="utf-8")
+        build = subprocess.run(["g++", "-std=c++17", f"-I{ROOT / 'src/split/src'}", str(src), "-o", str(exe)],
+                               capture_output=True, text=True)
+        if build.returncode != 0:
+            print("arch_caps.hpp ließ sich nicht bauen:\n" + build.stderr)
+            return 1
+        out = subprocess.run([str(exe)], capture_output=True, text=True)
+        if out.returncode != 0:
+            print("Der C++-Ausdruck lief nicht:\n" + out.stderr)
+            return 1
+        cpp = {int(a): int(b) for a, b in (line.split(":") for line in out.stdout.split())}
+
+    bad = 0
+    for cc in CCS:
+        py = SE.shared_mem_kib(f"sm_{cc}")
+        mark = "ok" if py == cpp[cc] else "ANDERS"
+        if py != cpp[cc]:
+            bad += 1
+        print(f"  sm_{cc:<4} C++ {cpp[cc]:>4} KiB   Python {py:>4} KiB   {mark}")
+    # die Layout-Entscheidung selbst: ab welcher Karte passen 32 Spalten?
+    wide_cpp = [cc for cc in CCS if cpp[cc] * 1024 >= 74372]
+    wide_py = [cc for cc in CCS if SE.shared_mem_kib(f"sm_{cc}") * 1024 >= SE.PROMPT_LAYOUT_KIB * 1024]
+    if wide_cpp != wide_py:
+        bad += 1
+        print(f"  Layout-Schwelle ANDERS: C++ {wide_cpp}, Python {wide_py}")
+    if bad:
+        print(f"arch_caps-Parität: {bad} Abweichungen")
+        return 1
+    print(f"arch_caps-Parität: alle {len(CCS)} Stufen gleich (32 Spalten ab {wide_cpp[0]}, darunter 16)")
+    return 0
+
+
+if __name__ == "__main__":
+    sys.exit(main())
