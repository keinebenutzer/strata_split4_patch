diff --git a/engine/src/split/tools/arch_caps_test.cpp b/engine/src/split/tools/arch_caps_test.cpp
new file mode 100644
index 000000000..fa7dccfe3
--- /dev/null
+++ b/engine/src/split/tools/arch_caps_test.cpp
@@ -0,0 +1,81 @@
+// CPU unit test of src/arch_caps.hpp: the shared-memory table against the published CUDA figures, the layout the
+// kernels need against that table, and the self-test rule for a card Strata has not run the split on.  No GPU, no card.
+#include "../src/arch_caps.hpp"
+
+#include <cstdio>
+#include <string>
+#include <vector>
+
+static int fails = 0;
+static void check(bool ok, const std::string& what) {
+    if (!ok) { ++fails; std::printf("FAIL: %s\n", what.c_str()); }
+}
+
+int main() {
+    using namespace fnx;
+
+    // the published per-block dynamic shared memory (CUDA Programming Guide, "Memory Information"): the table must say
+    // exactly this, because a kernel layout is chosen from it
+    const std::vector<std::pair<int, int>> published = {{61, 64}, {70, 96}, {75, 64}, {80, 163}, {86, 99}, {87, 163},
+                                                        {89, 99}, {90, 227}, {100, 227}, {103, 227}, {110, 227}, {120, 99}, {121, 99}};
+    for (const auto& e : published)
+        check(smem_per_block_kib(e.first) == e.second, "smem_per_block_kib(sm_" + std::to_string(e.first) + ") = " +
+                                                       std::to_string(smem_per_block_kib(e.first)) + ", published " + std::to_string(e.second));
+    // an unlisted capability takes the floor, never more: a bigger kernel than the card can launch is the failure to avoid
+    check(smem_per_block_kib(60) == SMEM_FLOOR_KIB && smem_per_block_kib(999) == SMEM_FLOOR_KIB, "an unlisted capability takes the floor");
+
+    // what k_gdn_ch_rec asks for (src/gdn_prompt.cuh: GCH 32, HS 128, the sub-chunk's prep floats): 32 columns are
+    // 72.6 KiB, 16 columns 56.6 KiB.  The 32-column layout therefore fits everywhere but a 64 KiB card, which is the
+    // whole reason the tree has a 16-column variant at all (the HIP build has always used it)
+    const int GCH = 32, HS = 128, PREP = 2 * GCH * GCH + 3 * GCH + 1;
+    const auto floats = [&](int gcb) { return 4 * (2 * GCH * (HS + 1) + HS * gcb + 4 * GCH * gcb + PREP); };
+    check(floats(32) == 74372, "the 32-column layout is 74372 bytes (72.6 KiB), got " + std::to_string(floats(32)));
+    check(floats(16) == 57988, "the 16-column layout is 57988 bytes (56.6 KiB), got " + std::to_string(floats(16)));
+    for (const auto& e : published) {
+        const bool wide = floats(32) <= smem_per_block(e.first);
+        const bool narrow_fits = floats(16) <= smem_per_block(e.first);
+        check(narrow_fits, "sm_" + std::to_string(e.first) + ": the 16-column layout must always fit");
+        // 32 columns need 72.6 KiB, so they fit exactly on a card with 96 KiB or more: the 64 KiB cards (6.1 Pascal,
+        // 7.5 Turing) are the ones the 16-column layout exists for
+        check(wide == (smem_per_block_kib(e.first) >= 96), "sm_" + std::to_string(e.first) + ": 32 columns " +
+                                                           (wide ? "fit" : "do not fit"));
+    }
+
+    // the two mma families the tree is laid out for (src/split/src/moe_mma.cuh: FNX_ARCH >= 80 uses m16n8k16, below it
+    // m8n8k4 with 64-row jobs) and the int8 paths compiled for the newer cards only
+    check(has_dp4a(61) && !has_dp4a(60), "dp4a from 6.1");
+    check(has_mma_16816(80) && !has_mma_16816(75), "the 16816 f16 mma from 8.0");
+    check(has_i8_attention(86) && !has_i8_attention(75), "the int8 attention path from 8.0");
+
+    // what Strata has run (strata_control/split_engine.py keeps the matching TESTED table for the card counts)
+    check(arch_run_by_strata(86) && arch_run_by_strata(120), "sm_86 and sm_120 are run architectures");
+    check(!arch_run_by_strata(75) && !arch_run_by_strata(90), "sm_75 and sm_90 are not: the self-test decides there");
+
+    // the rule: a known card starts without the self-test, an unknown card gets it, the environment can force or skip it
+    auto run_ok = [](std::string& covered) { covered = "expert tiles, attention tiles, dp4a, recurrent step"; return std::string(); };
+    auto run_bad = [](std::string&) { return std::string("attention tile mismatch"); };
+    NvSelftestDecision d = nv_selftest_decide(86, nullptr, nullptr, run_ok);
+    check(!d.run && d.ok && d.lines.empty(), "sm_86 starts without the self-test");
+    d = nv_selftest_decide(75, nullptr, nullptr, run_ok);
+    check(d.run && d.ok && d.lines.size() == 2, "sm_75 is announced as experimental and then tested");
+    check(d.lines[0].find("experimental") != std::string::npos && d.lines[0].find("sm_75") != std::string::npos, "the first line names the card");
+    check(d.lines[1].find("passed") != std::string::npos, "the second line reports the pass");
+    d = nv_selftest_decide(75, nullptr, nullptr, run_bad);
+    check(d.run && !d.ok && d.lines[1].find("does not run on this card") != std::string::npos, "a failed self-test stops the split engine");
+    d = nv_selftest_decide(86, (const char*) "1", nullptr, run_ok);
+    check(d.run && d.ok, "FNX_SELFTEST=1 asks a known card too");
+    d = nv_selftest_decide(75, (const char*) "0", nullptr, run_bad);
+    check(!d.run && d.ok && d.lines.empty(), "FNX_SELFTEST=0 skips it, the risk is the caller's");
+    d = nv_selftest_decide(86, (const char*) "1", (const char*) "1", run_ok);
+    check(d.run && !d.ok, "FNX_SELFTEST_FAIL=1 fails on purpose (the rule is testable without a broken card)");
+
+    // a person reading the line must learn what the card can do and what happens next
+    const std::string n86 = arch_note(86), n75 = arch_note(75);
+    check(n86.find("99 KiB") != std::string::npos && n86.find("run by Strata") != std::string::npos, "sm_86's line: " + n86);
+    check(n75.find("64 KiB") != std::string::npos && n75.find("not run by Strata") != std::string::npos, "sm_75's line: " + n75);
+
+    if (fails) { std::printf("arch_caps: %d FAIL\n", fails); return 1; }
+    std::printf("arch_caps: all checks passed (%d published capabilities, the 32-column layout is %d bytes, the 16-column %d)\n",
+                (int) published.size(), floats(32), floats(16));
+    return 0;
+}
